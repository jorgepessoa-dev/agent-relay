{
  "box_dir": "./agent-relay-mail",
  "agents": [
    {
      "name": "coord",
      "tmux_session": "claude",
      "busy_regex": "esc to interrupt",
      "input_prefix": "> ",
      "repo_path": "/opt/my-project",
      "placeholder": "Type your message"
    },
    {
      "name": "dc",
      "tmux_session": "deepcode_session",
      "busy_regex": "status: (processing|pending)",
      "input_prefix": "> ",
      "repo_path": "/opt/my-project"
    }
  ]
}
